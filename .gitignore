# Ignore macOS Finder metadata
.DS_Store

# Keep source notes public; keep raw article files local
/sources/*.pdf
/sources/*.txt

# Keep product sources; ignore rendered product artifacts
/products/**/*.html
/products/**/*.pdf
/products/**/*.docx
/products/**/*.typ
/products/**/*.ttt
/products/**/*_files/
/products/**/.quarto/
/products/**/~$*.docx

# Keep the short presentation render under version control
!/products/presentations/presentation-short.html
